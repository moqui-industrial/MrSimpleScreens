<#-- Ported from the original FreeMarker template; HTML interpolation is escaped.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#assign dateFormat = dateFormat ?? "dd MMM yyyy">

<p>${ec.l10n.localize('The following invoices are now past due and we have not received payment for the unpaid amounts listed below.')}</p>

<p>${ec.l10n.localize('Please contact us immediately to discuss payment options.')}</p>

<p><strong>${ec.l10n.localize('Past Due Invoices')}</strong></p>
<table border="0" cellpadding="8px" cellspacing="3" width="100%">
    <tr><td>${ec.l10n.localize('Your Order')}</td><td>${ec.l10n.localize('Ref #')}</td><td>${ec.l10n.localize('Invoice #')}</td><td>${ec.l10n.localize('Date')}</td><td>${ec.l10n.localize('Due')}</td><td>${ec.l10n.localize('Total')}</td><td>${ec.l10n.localize('Unpaid')}</td></tr>
    <#list invoiceList as invoice>
        <tr>
            <td>${invoice.otherPartyOrderId ?? ""}</td>
            <td>${invoice.referenceNumber ?? ""}</td>
            <td>${invoice.invoiceId}</td>
            <td>${ec.l10n.format(invoice.invoiceDate ?? null, dateFormat)}</td>
            <td>${ec.l10n.format(invoice.dueDate ?? null, dateFormat)}</td>
            <td>${ec.l10n.formatCurrency(invoice.invoiceTotal ?? 0, invoice.currencyUomId ?? "USD")}</td>
            <td>${ec.l10n.formatCurrency(invoice.unpaidTotal ?? 0, invoice.currencyUomId ?? "USD")}</td>
        </tr>
    </#list>
</table>

<#if (paymentList?.length> 0)>
<p><strong>${ec.l10n.localize('Payments not yet Applied')}</strong></p>
<table border="0" cellpadding="8px" cellspacing="3" width="100%">
    <tr><td>${ec.l10n.localize('Payment Ref #')}</td><td>${ec.l10n.localize('Payment #')}</td><td>${ec.l10n.localize('Date')}</td><td>${ec.l10n.localize('Total')}</td><td>${ec.l10n.localize('Unapplied')}</td></tr>
    <#list paymentList as payment>
        <tr>
            <td>${payment.paymentRefNum ?? ""}</td>
            <td>${payment.paymentId}</td>
            <td>${ec.l10n.format(payment.effectiveDate ?? null, dateFormat)}</td>
            <td>${ec.l10n.formatCurrency(payment.amount ?? 0, payment.amountUomId ?? "USD")}</td>
            <td>${ec.l10n.formatCurrency(payment.unappliedTotal ?? 0, payment.amountUomId ?? "USD")}</td>
        </tr>
    </#list>
</table>
</#if>

<#if (creditInvoiceList?.length> 0)>
<p><strong>${ec.l10n.localize('Credit Memos not yet Applied')}</strong></p>
<table border="0" cellpadding="8px" cellspacing="3" width="100%">
    <tr><td>${ec.l10n.localize('Your Order')}</td><td>${ec.l10n.localize('Credit Ref #')}</td><td>${ec.l10n.localize('Memo #')}</td><td>${ec.l10n.localize('Date')}</td><td>${ec.l10n.localize('Due')}</td><td>${ec.l10n.localize('Total')}</td><td>${ec.l10n.localize('Unapplied')}</td></tr>
    <#list creditInvoiceList as invoice>
        <tr>
            <td>${invoice.otherPartyOrderId ?? ""}</td>
            <td>${invoice.referenceNumber ?? ""}</td>
            <td>${invoice.invoiceId}</td>
            <td>${ec.l10n.format(invoice.invoiceDate ?? null, dateFormat)}</td>
            <td>${ec.l10n.format(invoice.dueDate ?? null, dateFormat)}</td>
            <td>${ec.l10n.formatCurrency(invoice.invoiceTotal ?? 0, invoice.currencyUomId ?? "USD")}</td>
            <td>${ec.l10n.formatCurrency(invoice.unpaidTotal ?? 0, invoice.currencyUomId ?? "USD")}</td>
        </tr>
    </#list>
</table>
</#if>

<p><strong>${ec.l10n.localize('Total Past Due')}</strong> ${ec.l10n.format(toDecimal(unpaidInvoiceTotal ?? 0).subtract(unappliedPaymentTotal ?? 0).subtract(creditInvoiceTotal ?? 0), "#,##0.00")}</p>

<p><strong>${ec.l10n.localize('Customer #')}</strong> ${toParty.pseudoId}</p>
