<#-- Ported from the original FreeMarker template; HTML interpolation is escaped.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#assign dateFormat = (dateFormat ?? "dd MMM yyyy")>
<table border="0" cellpadding="8px" cellspacing="0" width="100%"><tr>
    <td width="50%">
        <h1>${ec.l10n.localize('Invoice')} ${invoiceId}</h1><br/>
        <#if (finalizedStatusHistoryList.length> 1)>
            <h4>${ec.l10n.localize('AMENDED')} ${ec.l10n.format(finalizedStatusHistoryList[0].changedDate, dateFormat)} (${ec.l10n.localize('previous')} ${ec.l10n.format(finalizedStatusHistoryList[1].changedDate, dateFormat)})</h4>
        </#if>
        <#if has(detailLinkPath)>
            <#list orderIdSet as orderId>
            <strong><a href="<#if detailLinkPath.startsWith("http")>${detailLinkPath}<#else>http://${storeDomain}/${detailLinkPath}</#if>?orderId=${orderId}">${ec.l10n.localize('For Order')} ${orderId}</a></strong><br/>
            </#list>
        <#else>
            <#list orderIdSet as orderId><strong>${ec.l10n.localize('For Order')} ${orderId}</strong><br/></#list>
        </#if>
        <strong>${ec.l10n.localize('Invoice Date')}</strong> ${ec.l10n.format(invoice.invoiceDate, dateFormat)}<br/>
        <strong>${ec.l10n.localize('Customer #')}</strong> ${toParty.pseudoId}<br/>
        <#if has(invoice?.referenceNumber)><strong>${ec.l10n.localize('Ref #')}</strong> ${invoice.referenceNumber}<br/></#if>
        <#if has(invoice?.otherPartyOrderId)><strong>${ec.l10n.localize('Your Order')}</strong> ${invoice.otherPartyOrderId}<br/></#if>
        <br/>
        <#if toDecimal(unpaidTotal ?? 0).compare(0) == 0>
            <strong>${ec.l10n.localize('PAID IN FULL')}</strong><br/>
        <#else>
            <strong>${ec.l10n.localize('Balance Due')}</strong> ${ec.l10n.formatCurrency(unpaidTotal, invoice.currencyUomId)}<br/>
        </#if>
        <#if toDecimal(unpaidTotal ?? 0).compare(0) != 0>
            <#if (invoice.dueDate != null)>
                <strong>${ec.l10n.localize('Due Date')}</strong> ${ec.l10n.format(invoice.dueDate, dateFormat)}<br/>
            </#if>
            <#if has(settlementTerm)>
                <strong>${ec.l10n.localize('Term')}</strong> ${settlementTerm.description}<br/>
            </#if>
        </#if>
    </td>
    <td width="50%">
    <#if has(fromContactInfo?.postalAddress)>
        <#if has(fromContactInfo?.postalAddress?.toName) || has(fromContactInfo?.postalAddress?.attnName)>
            <#if has(fromContactInfo?.postalAddress?.toName)><strong>${ec.l10n.localize('To')}: ${fromContactInfo.postalAddress.toName}</strong><br/></#if>
            <#if has(fromContactInfo?.postalAddress?.attnName)><strong>${ec.l10n.localize('Attn')}: ${fromContactInfo.postalAddress.attnName}</strong><br/></#if>
        <#else>
            <strong>${(fromParty?.organizationName ?? "")} ${(fromParty?.firstName ?? "")} ${(fromParty?.middleName ?? "")} ${(fromParty?.lastName ?? "")}</strong><br/>
        </#if>
    ${(fromContactInfo?.postalAddress?.address1 ?? "")}<#if has(fromContactInfo?.postalAddress?.unitNumber)> #${fromContactInfo.postalAddress.unitNumber}</#if><br/>
        <#if has(fromContactInfo?.postalAddress?.address2)>${fromContactInfo.postalAddress.address2}<br/></#if>
    ${(fromContactInfo.postalAddress.city ?? "")}, ${(fromContactInfo?.postalAddressStateGeo?.geoCodeAlpha2 ?? "")} ${(fromContactInfo.postalAddress.postalCode ?? "")}<#if has(fromContactInfo?.postalAddress?.postalCodeExt)>-${fromContactInfo.postalAddress.postalCodeExt}</#if><#if has(fromContactInfo?.postalAddress?.countryGeoId)> ${fromContactInfo.postalAddress.countryGeoId}</#if><br/>
    </#if>
    <#if has(fromContactInfo?.telecomNumber)>
        <#if has(fromContactInfo?.telecomNumber?.countryCode)>${ec.l10n.localize('Tel')}: ${fromContactInfo.telecomNumber.countryCode}-</#if><#if has(fromContactInfo?.telecomNumber?.areaCode)>${fromContactInfo.telecomNumber.areaCode}-</#if>${(fromContactInfo.telecomNumber.contactNumber ?? "")}<br/>
    </#if>
    <#if has(fromContactInfo?.faxTelecomNumber)>
        <#if has(fromContactInfo?.faxTelecomNumber?.countryCode)>${ec.l10n.localize('Fax')}: ${fromContactInfo.faxTelecomNumber.countryCode}-</#if><#if has(fromContactInfo?.faxTelecomNumber?.areaCode)>${fromContactInfo.faxTelecomNumber.areaCode}-</#if>${(fromContactInfo.faxTelecomNumber.contactNumber ?? "")}<br/>
    </#if>
    <#if has(fromContactInfo?.emailAddress)>
        ${fromContactInfo.emailAddress}<br/>
    </#if>
    </td>
</tr></table>

<strong>${ec.l10n.localize('See details in attachment.')}</strong><br/><br/>

<#if has(invoice?.invoiceMessage)>
    ${invoice.invoiceMessage}<br/>
</#if>
