<!-- The git repositories of a project (mantle.work.GitServices; the repositories are hosted by MR Moqui at /git and over
    SSH), and the tags linked to it. New screen, no SimpleScreens original. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Repositories" default-menu-index="6">

    <parameter name="rootWorkEffortId" required="true"/>

    <transition name="addRepository"><service-call name="mantle.work.GitServices.add#ProjectRepository"
            in-map="{workEffortId:rootWorkEffortId, repositoryId:repositoryId}"/>
        <default-response url="."/></transition>
    <transition name="createRepository"><service-call name="mantle.work.GitServices.create#ProjectRepository"
            in-map="{workEffortId:rootWorkEffortId, repositoryId:repositoryId, repositoryKind:repositoryKind, description:description}"/>
        <default-response url="."/></transition>
    <transition name="removeRepository"><service-call name="mantle.work.GitServices.remove#ProjectRepository"
            in-map="{workEffortId:rootWorkEffortId, repositoryId:repositoryId}"/>
        <default-response url="."/></transition>
    <transition name="removeRef"><service-call name="mantle.work.GitServices.remove#WorkEffortRef"
            in-map="{workEffortId:rootWorkEffortId, repositoryId:repositoryId, refName:refName}"/>
        <default-response url="."/></transition>
    <transition name="gitCommit"><default-response url="../GitCommit"/></transition>

    <actions>
        <set field="workEffortId" from="rootWorkEffortId"/>
        <entity-find entity-name="mantle.work.effort.WorkEffortGitRepository" list="linkList">
            <date-filter/><econdition field-name="workEffortId"/><order-by field-name="repositoryId"/></entity-find>
        <set field="repositoryList" from="[]"/>
        <iterate list="linkList" entry="link">
            <entity-find-one entity-name="moqui.resource.GitRepository" value-field="repository">
                <field-map field-name="repositoryId" from="link.repositoryId"/></entity-find-one>
            <!-- a user who may not see the repository gets no clone URLs; the row still shows -->
            <set field="urls" from="null"/>
            <script>try { urls = ec.service.sync().name('org.moqui.impl.GitServices.get#GitCloneUrls').parameters({repositoryId:link.repositoryId}).call() }
                finally { ec.message.clearErrors() }</script>
            <script>repositoryList.push({repositoryId:link.repositoryId, description:repository?.description,
                repositoryKind:repository?.repositoryKind || 'local', branch:repository?.branch || 'main',
                headCommitId:repository?.headCommitId, lastUpdateDate:repository?.lastUpdateDate, fromDate:link.fromDate,
                httpsUrl:urls?.httpsUrl, sshUrl:urls?.sshUrl})</script>
        </iterate>
        <entity-find entity-name="moqui.resource.GitRepository" list="allRepositoryList">
            <select-field field-name="repositoryId,description,repositoryKind"/><order-by field-name="repositoryId"/></entity-find>
        <entity-find entity-name="mantle.work.effort.WorkEffortGitRef" list="refList">
            <econdition field-name="workEffortId"/><econdition field-name="thruDate" operator="is-null"/>
            <order-by field-name="-linkedDate"/></entity-find>
    </actions>
    <widgets>
        <container>
            <container-dialog id="AddRepositoryDialog" button-text="Add Repository">
                <form-single name="AddRepositoryForm" transition="addRepository">
                    <field name="rootWorkEffortId"><default-field><hidden/></default-field></field>
                    <field name="repositoryId"><default-field title="Repository"><drop-down>
                        <list-options list="allRepositoryList" key="${repositoryId}"
                                text="${repositoryId}${description ? ': ' + description : ''} (${repositoryKind || 'local'})"/>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="CreateRepositoryDialog" button-text="New Repository">
                <form-single name="CreateRepositoryForm" transition="createRepository">
                    <field name="rootWorkEffortId"><default-field><hidden/></default-field></field>
                    <field name="repositoryId" from="rootWorkEffortId.toLowerCase()"><default-field title="Repository ID">
                        <text-line size="30"/></default-field></field>
                    <field name="description"><default-field><text-line size="60"/></default-field></field>
                    <field name="repositoryKind"><default-field title="Storage"><radio no-current-selected-key="local">
                        <option key="local" text="On disk (for code: clone and push it with git)"/>
                        <option key="db" text="In the database (kept with the database backup)"/>
                    </radio></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <form-list name="RepositoryList" list="repositoryList" transition="removeRepository">
            <field name="rootWorkEffortId" from="workEffortId"><default-field><hidden/></default-field></field>
            <field name="repositoryId"><default-field title="Repository"><display/></default-field></field>
            <field name="description"><default-field><display/></default-field></field>
            <field name="repositoryKind"><default-field title="Storage"><display/></default-field></field>
            <field name="branch"><default-field title="Default Branch"><display/></default-field></field>
            <field name="headCommitId"><default-field title="Head">
                <link url="gitCommit" text="${headCommitId?.substring(0, 10) ?? ''}" link-type="anchor" condition="headCommitId">
                    <parameter name="repositoryId"/><parameter name="commitId" from="headCommitId"/>
                    <parameter name="rootWorkEffortId" from="workEffortId"/></link>
            </default-field></field>
            <field name="lastUpdateDate"><default-field title="Last Change"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
            <field name="httpsUrl"><default-field title="Clone URLs"><display text="${httpsUrl ?? ''}"/>
                <display text="${sshUrl ?? ''}"/></default-field></field>
            <field name="submitButton"><default-field title="Remove"><submit confirmation="Unlink this repository from the project?"/></default-field></field>
        </form-list>

        <label text="Tags" type="h5"/>
        <form-list name="ProjectRefList" list="refList" transition="removeRef">
            <field name="rootWorkEffortId" from="workEffortId"><default-field><hidden/></default-field></field>
            <field name="repositoryId"><default-field title="Repository"><display/></default-field></field>
            <field name="refName"><default-field title="Tag"><display text="${refName.replace('refs/heads/', '').replace('refs/tags/', '')}"/></default-field></field>
            <field name="objectId"><default-field title="Commit">
                <link url="gitCommit" text="${objectId?.substring(0, 10) ?? ''}" link-type="anchor" condition="objectId">
                    <parameter name="repositoryId"/><parameter name="commitId" from="objectId"/>
                    <parameter name="rootWorkEffortId" from="workEffortId"/></link>
            </default-field></field>
            <field name="linkSourceEnumId"><default-field title="Linked By"><display-entity entity-name="moqui.basic.Enumeration"/></default-field></field>
            <field name="linkedDate"><default-field title="Linked"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
            <field name="submitButton"><default-field title="Remove"><submit/></default-field></field>
        </form-list>
    </widgets>
</screen>
