<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        standalone="true">

    <parameter name="productContentId" required="true"/>
    <parameter name="versionNameLhs"/>
    <parameter name="versionNameRhs"/>

    <actions>
        <set field="versionNameRhs" from="versionNameRhs || versionNameLhs"/>
        <entity-find-one entity-name="mantle.product.ProductContent" value-field="productContent"/>
        <set field="resourceRef" from="ec.resource.getLocationReference(productContent?.contentLocation)"/>
        <!-- one version is shown as its text; two are compared on the server (ResourceReference.getVersionDiff), an
            HTML table with every text escaped, where the Java screen diffed characters in the browser with jsdiff -->
        <script><![CDATA[
            versionText = null
            diffHtml = ''
            if (versionNameLhs == versionNameRhs) {
                versionText = resourceRef?.getText(versionNameLhs) || ''
            } else {
                try {
                    const diff = resourceRef?.getVersionDiff(versionNameLhs, versionNameRhs)
                    if (diff) {
                        diffHtml = diff.html
                        diffStats = diff.stats.insertions + ' added, ' + diff.stats.deletions + ' removed'
                    }
                } catch (err) {
                    ec.message.addError('Cannot compare: ' + err.message)
                }
            }
        ]]></script>
    </actions>
    <widgets>
        <section name="OneVersion" condition="versionText != null"><widgets>
            <container-box><box-header title="Version ${versionNameLhs.substring(0, 12)}"/><box-body>
                <label text="${versionText}" type="pre" style="pre-plain"/>
            </box-body></container-box>
        </widgets><fail-widgets>
            <container-box><box-header title="Compare versions ${versionNameLhs.substring(0, 12)} and ${versionNameRhs.substring(0, 12)}"/><box-toolbar>
                <label text="${diffStats || ''}" type="span"/>
            </box-toolbar><box-body>
                <render-mode><text type="html,vuet,qvt"><![CDATA[<div class="scroll">${diffHtml}</div>]]></text></render-mode>
            </box-body></container-box>
        </fail-widgets></section>
    </widgets>
</screen>
