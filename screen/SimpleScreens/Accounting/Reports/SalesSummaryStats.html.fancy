<#-- Sales summary metrics, ported from the original statsPanel calls. -->
<#if sri.getRenderMode() == "vuet" || sri.getRenderMode() == "html">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js" type="text/javascript"></script>
</#if>
<div class="row">
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Order Count", mainFormat: "#,##0", valThis: ordersThis?.orderCount ?? 0, valLast: ordersLast?.orderCount ?? 0, valPrior: ordersPrior?.orderCount ?? 0, valAvg: ordersAverage?.orderCount ?? 0, chartList: Array.from(orderSummaryNoTotals ?? []).map(it => it.orderCount), chartMaList: Array.from(orderSummaryNoTotals ?? []).map(it => it.orderCountMa), labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "New Customer Count", mainFormat: "#,##0", valThis: ordersThis?.newCustomerOrderCount ?? 0, valLast: ordersLast?.newCustomerOrderCount ?? 0, valPrior: ordersPrior?.newCustomerOrderCount ?? 0, valAvg: ordersAverage?.newCustomerOrderCount ?? 0, chartList: Array.from(orderSummaryNoTotals ?? []).map(it => it.newCustomerOrderCount), chartMaList: Array.from(orderSummaryNoTotals ?? []).map(it => it.newCustomerOrderCountMa), labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "New Customer Percent", mainFormat: "0.0%", valThis: ordersThis?.newCustomerPercent ?? 0, valLast: ordersLast?.newCustomerPercent ?? 0, valPrior: ordersPrior?.newCustomerPercent ?? 0, valAvg: ordersAverage?.newCustomerPercent ?? 0, chartList: newCustomerPercentList, chartMaList: newCustomerPercentMaList, labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Order Quantity", mainFormat: "#,##0", valThis: ordersThis?.productQuantityTotal ?? 0, valLast: ordersLast?.productQuantityTotal ?? 0, valPrior: ordersPrior?.productQuantityTotal ?? 0, valAvg: ordersAverage?.productQuantityTotal ?? 0, chartList: Array.from(orderSummaryNoTotals ?? []).map(it => it.productQuantityTotal), chartMaList: Array.from(orderSummaryNoTotals ?? []).map(it => it.productQuantityTotalMa), labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Order Product Sales", mainFormat: "$#,##0", valThis: ordersThis?.productSaleTotal ?? 0, valLast: ordersLast?.productSaleTotal ?? 0, valPrior: ordersPrior?.productSaleTotal ?? 0, valAvg: ordersAverage?.productSaleTotal ?? 0, chartList: orderProductSaleTotalList, chartMaList: Array.from(orderSummaryNoTotals ?? []).map(it => it.productSaleTotalMa), labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Order Discount Percent", mainFormat: "0.0%", valThis: ordersThis?.discountPercent ?? 0, valLast: ordersLast?.discountPercent ?? 0, valPrior: ordersPrior?.discountPercent ?? 0, valAvg: ordersAverage?.discountPercent ?? 0, chartList: orderDiscountPercentList, chartMaList: orderDiscountPercentMaList, labelList: orderLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Order Net Product", mainFormat: "$#,##0", valThis: ordersThis?.netSales ?? 0, valLast: ordersLast?.netSales ?? 0, valPrior: ordersPrior?.netSales ?? 0, valAvg: ordersAverage?.netSales ?? 0, chartList: orderNetSalesList, chartMaList: Array.from(orderSummaryNoTotals ?? []).map(it => it.netSalesMa), labelList: orderLabelList}))}</div>
</div>
<div class="row">
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Invoice Count", mainFormat: "#,##0", valThis: invoicesThis?.invoiceCount ?? 0, valLast: invoicesLast?.invoiceCount ?? 0, valPrior: invoicesPrior?.invoiceCount ?? 0, valAvg: invoicesAverage?.invoiceCount ?? 0, chartList: Array.from(invoiceSummaryNoTotals ?? []).map(it => it.invoiceCount), chartMaList: Array.from(invoiceSummaryNoTotals ?? []).map(it => it.invoiceCountMa), labelList: invoiceLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Invoiced Quantity", mainFormat: "#,##0", valThis: invoicesThis?.productQuantityTotal ?? 0, valLast: invoicesLast?.productQuantityTotal ?? 0, valPrior: invoicesPrior?.productQuantityTotal ?? 0, valAvg: invoicesAverage?.productQuantityTotal ?? 0, chartList: Array.from(invoiceSummaryNoTotals ?? []).map(it => it.productQuantityTotal), chartMaList: Array.from(invoiceSummaryNoTotals ?? []).map(it => it.productQuantityTotalMa), labelList: invoiceLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Invoices Total", mainFormat: "$#,##0", valThis: invoicesThis?.invoiceTotal ?? 0, valLast: invoicesLast?.invoiceTotal ?? 0, valPrior: invoicesPrior?.invoiceTotal ?? 0, valAvg: invoicesAverage?.invoiceTotal ?? 0, chartList: invoiceTotalList, chartMaList: invoiceTotalMaList, labelList: invoiceLabelList}))}</div>
