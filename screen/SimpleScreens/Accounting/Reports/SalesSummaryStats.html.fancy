<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Pre-Paid Percent", mainFormat: "0.0%", valThis: invoicesThis?.prePaidPercent ?? 0, valLast: invoicesLast?.prePaidPercent ?? 0, valPrior: invoicesPrior?.prePaidPercent ?? 0, valAvg: invoicesAverage?.prePaidPercent ?? 0, chartList: invoicePrePaidPercentList, chartMaList: invoicePrePaidPercentMaList, labelList: invoiceLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Invoice Cost Percent", mainFormat: "0.0%", valThis: invoicesThis?.costPercent ?? 0, valLast: invoicesLast?.costPercent ?? 0, valPrior: invoicesPrior?.costPercent ?? 0, valAvg: invoicesAverage?.costPercent ?? 0, chartList: invoiceCostPercentList, chartMaList: invoiceCostPercentMaList, labelList: invoiceLabelList}))}</div>
<div class="${statsPanelColStyle}">${raw(ec.resource.template("component://mr-marble/screen/SimpleScreens/Accounting/Reports/SalesSummaryStats-panel.html.fancy", {title: "Invoice Discount Percent", mainFormat: "0.0%", valThis: invoicesThis?.discountPercent ?? 0, valLast: invoicesLast?.discountPercent ?? 0, valPrior: invoicesPrior?.discountPercent ?? 0, valAvg: invoicesAverage?.discountPercent ?? 0, chartList: invoiceDiscountPercentList, chartMaList: invoiceDiscountPercentMaList, labelList: invoiceLabelList}))}</div>
</div>
