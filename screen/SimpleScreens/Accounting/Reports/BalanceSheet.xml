<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false">

    <parameter name="organizationPartyId" required="true"/>
    <parameter name="timePeriodIdList" required="true"/>
    <transition name="accountLedger"><default-response url="../AccountLedger"/></transition>

    <actions>
        <service-call name="mantle.ledger.LedgerReportServices.run#BalanceSheet" out-map="context" in-map="context"/>
        <!-- the statement's rows are built in LedgerReport.js: the fancy template dialect has no macros or decimal operators -->
        <script>
            const ledger = ec.resource.script('component://mr-marble/template/ledger/LedgerReport.js')
            ledgerTable = ledger.balanceSheet(sri.buildUrl('accountLedger'))
            if (sri.getRenderMode() == 'tui') ledgerTui = ledger.tui(ledgerTable)
            if (sri.getRenderMode() == 'csv') ledgerCsv = ledger.csv(ledgerTable)
        </script>
        <!-- the path as text: a URL object does not survive being put in the context -->
        <set field="csvPath" from="sri.getScreenUrlInstance().cloneUrlInstance().addParameter('renderMode', 'csv').addParameter('saveFilename', 'BalanceSheet.csv').getPathWithParams()"/>
    </actions>
    <widgets>
        <link url="${csvPath}" url-type="plain" text="Get CSV"/>
        <render-mode>
            <text type="html,vuet,qvt" location="component://mr-marble/template/ledger/LedgerTable.html.fancy"
                    template="true" encode="false" no-boundary-comment="true"/>
            <text type="tui" template="true"><![CDATA[${JSON.stringify(ledgerTui)}]]></text>
            <text type="csv" template="true" no-boundary-comment="true"><![CDATA[${ledgerCsv}]]></text>
        </render-mode>
    </widgets>
</screen>
