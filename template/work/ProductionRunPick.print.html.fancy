<style>
@page mrss-ProductionRunPick { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ProductionRunPick { page:mrss-ProductionRunPick; font:10pt Helvetica,Arial,sans-serif; }
.print-ProductionRunPick .page-header { position:relative; min-height:0.5in; }
.print-ProductionRunPick .page-footer { margin-top:.2in; }
.print-ProductionRunPick table { border-collapse:collapse; table-layout:fixed; }
.print-ProductionRunPick thead { display:table-header-group; }
.print-ProductionRunPick tbody tr { break-inside:avoid; }
table.print-running { width:100%; }
table.print-running > tbody > tr { break-inside:auto; }
table.print-running > * > tr > td { padding:0; vertical-align:top; }
</style>
<section class="print-ProductionRunPick">
<#-- Ported from the XSL-FO document by scripts/xslfo-to-html-print.py and by hand; the html-print mode writes the page.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#--
This software is in the public domain under CC0 1.0 Universal plus a Grant of Patent License.

To the extent possible under law, the author(s) have dedicated all
copyright and related and neighboring rights to this software to the
public domain worldwide. This software is distributed without any
warranty.

You should have received a copy of the CC0 Public Domain Dedication
along with this software (see the LICENSE.md file). If not, see
<http://creativecommons.org/publicdomain/zero/1.0/>.
-->

<#-- See the mantle.work.ManufacturingServices.get#ProductionRunPickInfo service for data preparation -->

<#assign cellPadding = "1pt">
<#assign dateFormat = (dateFormat ?? "dd MMM yyyy")>
<#assign dateTimeFormat = (dateTimeFormat ?? "yyyy-MM-dd HH:mm")>

<#-- The XSL-FO region-before: a table head, which Chromium repeats at the top of every page the body runs onto. -->
<table class="print-running"><thead><tr><td><div class="page-header">
            <div style="font-size:12pt;text-align:center;margin-bottom:0.1in">Production Run Picklist</div>
            <div style="position:absolute;top:0in;right:0.5in;width:3in">
                <div style="text-align:right">
                    ${raw(ec.resource.code128Svg(workEffortId, {height: '0.4in', moduleWidth: '0.3mm', fontSize: '12pt', humanReadable: true}))}
                </div>
            </div>
        </div></td></tr></thead><tbody><tr><td>
        

        <div class="page-body">
            <table style="margin-bottom:0.1in;width:7.5in">
                <tbody><tr>
                    <td style="padding:3pt;width:3in">
                        <div style="font-weight:bold">Run #</div>
                        <div>${workEffortId}</div>
                        <#if has(warehouseFacility)>
                            <div style="font-weight:bold">Warehouse</div>
                            <div>${ec.resource.expand("FacilityNameTemplate", "", warehouseFacility)}</div>
                        </#if>
                        <#if has(lineFacility)>
                            <div style="font-weight:bold">Line</div>
                            <div>${ec.resource.expand("FacilityNameTemplate", "", lineFacility)}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:1.5in">
                        <#if (workEffort.estimatedStartDate != null)>
                            <div style="font-weight:bold">Est. Start</div>
                            <div>${ec.l10n.format(workEffort.estimatedStartDate, dateTimeFormat)}</div>
                        </#if>
                        <#if (workEffort.estimatedWorkDuration != null)>
                            <div style="font-weight:bold">Est. Hours</div>
                            <div>${ec.l10n.format(workEffort.estimatedWorkDuration, "#,##0.###")}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:3in">
                        <div style="font-weight:bold">Equipment</div>
                        <#if has(equipmentList)>
                            <#list equipmentList as equipment>
                                <div>${ec.resource.expand("AssetNameTemplate", "", equipment)}</div>
                            </#list>
                        </#if>
                    </td>
                </tr></tbody>
            </table>

            <#if has(locationInfoList)>
                <table style="width:7.5in;border-bottom:solid black">
                    <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:2in;padding:${cellPadding}"><div style="text-align:left">By Location</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Area</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Aisle</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Sec</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Level</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Pos</div></td>

                        <td style="width:2in;padding:${cellPadding}"><div> </div></td>
                        <td style="width:1in;padding:${cellPadding}"><div style="text-align:right">Quantity</div></td>
                    </tr></thead>
                    <tbody>
                    <#list locationInfoList as locationInfo>
                        <tr style="font-size:9pt;border-top:solid black">
                            <td style="padding:${cellPadding}"><div style="text-align:left">${(locationInfo.description ?? "No Location")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.areaId ?? " ")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.aisleId ?? " ")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.sectionId ?? " ")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.levelId ?? " ")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.positionId ?? " ")}</div></td>

                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div> </div></td>
                        </tr>
                        <#list locationInfo.productInfoList as productInfo>
                            <tr style="font-size:9pt">
                                <td colspan="4" style="padding:${cellPadding}"><div style="text-align:center">
                                    ${raw(ec.resource.code128Svg(productInfo.productId, {height: '0.4in', moduleWidth: '0.25mm', fontSize: '7pt', humanReadable: true}))}
                                </div></td>
                                <td colspan="3" style="padding:${cellPadding}"><div style="text-align:left">${ec.resource.expand("ProductNameTemplate", "", productInfo)}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.format(productInfo.quantity, "#,##0.###")}</div></td>
                            </tr>
                        </#list>
                    </#list>
                    </tbody>
                </table>
            </#if>
            <#if has(productInfoList)>
                <table style="width:7.5in;border-bottom:solid black;margin-top:10pt">
                    <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:2in;padding:${cellPadding}"><div style="text-align:left">By Product</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Area</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Aisle</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Sec</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Level</div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Pos</div></td>

                        <td style="width:2in;padding:${cellPadding}"><div> </div></td>
                        <td style="width:1in;padding:${cellPadding}"><div style="text-align:right">Quantity</div></td>
                    </tr></thead>
                    <tbody>
                    <#list productInfoList as productInfo>
                        <tr style="font-size:9pt;border-top:solid black">
                            <td colspan="4" style="padding:${cellPadding}"><div style="text-align:center">
                                ${raw(ec.resource.code128Svg(productInfo.productId, {height: '0.4in', moduleWidth: '0.25mm', fontSize: '7pt', humanReadable: true}))}
                            </div></td>
                            <td colspan="3" style="padding:${cellPadding}"><div style="text-align:left">${ec.resource.expand("ProductNameTemplate", "", productInfo)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.format(productInfo.quantity, "#,##0.###")}</div></td>
                        </tr>
                        <#if has(productInfo?.locationInfoList)><#list productInfo.locationInfoList as locationInfo>
                            <tr style="font-size:9pt">
                                <td style="padding:${cellPadding}"><div style="text-align:left">${(locationInfo.description ?? "No Location")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.areaId ?? " ")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.aisleId ?? " ")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.sectionId ?? " ")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.levelId ?? " ")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(locationInfo.positionId ?? " ")}</div></td>

                                <td style="padding:${cellPadding}"><div> </div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.format(locationInfo.quantity, "#,##0.###")}</div></td>
                            </tr>
                        </#list></#if>
                    </#list>
                    </tbody>
                </table>
            </#if>
        </div></td></tr></tbody></table>
    
<#-- The XSL-FO region-after: a margin box of this document's page, so it prints at the foot of every page -->
<style>@page mrss-ProductionRunPick { @bottom-center { content: ${cssString("Picklist for Run #" + workEffortId + " -- " + (workEffort.estimatedStartDate != null ? ec.l10n.format(workEffort.estimatedStartDate, dateTimeFormat) + " -- " : "") + "Printed " + ec.l10n.format(ec.user.nowTimestamp, dateTimeFormat) + " -- Page ")} counter(page);
    white-space: pre-wrap; font: 8pt Helvetica, Arial, sans-serif; text-align: center; vertical-align: top; border-top: thin solid black; width: 100%; } }</style>
</section>
