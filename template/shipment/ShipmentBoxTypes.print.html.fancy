<style>
@page mrss-ShipmentBoxTypes { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ShipmentBoxTypes { page:mrss-ShipmentBoxTypes; font:10pt Helvetica,Arial,sans-serif; }
.print-ShipmentBoxTypes .page-header { position:relative; min-height:0.5in; }
.print-ShipmentBoxTypes .page-footer { margin-top:.2in; }
.print-ShipmentBoxTypes table { border-collapse:collapse; table-layout:fixed; }
.print-ShipmentBoxTypes thead { display:table-header-group; }
.print-ShipmentBoxTypes tbody tr { break-inside:avoid; }
table.print-running { width:100%; }
table.print-running > tbody > tr { break-inside:auto; }
table.print-running > * > tr > td { padding:0; vertical-align:top; }
</style>
<section class="print-ShipmentBoxTypes">
<#-- Ported from the XSL-FO document by scripts/xslfo-to-html-print.py and by hand; the html-print mode writes the page.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#--
This software is in the public domain under CC0 1.0 Universal plus a Grant of Patent License.

To the extent possible under law, the author(s) have dedicated all
copyright and related and neighboring rights to this software to the
public domain worldwide. This software is distributed without any
warranty.

You should have received a copy of the CC0 Public Domain Dedication
along with this software (see the LICENSE.md file). If not, see
<http://creativecommons.org/publicdomain/zero/1.0/>.
-->

<#-- Data preparation: <entity-find entity-name="mantle.shipment.ShipmentBoxTypeDetail" list="boxTypeList"><order-by field-name="pseudoId"/></entity-find> -->

<#assign cellPadding = "1pt">


<#-- The XSL-FO region-before: a table head, which Chromium repeats at the top of every page the body runs onto. -->
<table class="print-running"><thead><tr><td><div class="page-header">
        <#if has(fromPartyDetail)><div style="font-size:14pt;text-align:center">${(fromPartyDetail.organizationName ?? "")}${(fromPartyDetail.firstName ?? "")} ${(fromPartyDetail.lastName ?? "")}</div></#if>
            <div style="font-size:12pt;text-align:center;margin-bottom:0.1in">Box Types</div>
        </div></td></tr></thead><tbody><tr><td>

        <div class="page-body">
            <table style="width:7.5in;border-bottom:solid black;margin-top:10pt">
                <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                    <td style="width:3.0in;padding:${cellPadding}"><div style="text-align:center">ID</div></td>
                    <td style="width:2.5in;padding:${cellPadding}"><div>Description</div></td>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:center">L x W x H</div></td>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:center">Weight</div></td>
                </tr></thead>
                <tbody>
                <#list boxTypeList as boxType>
                    <tr style="font-size:9pt;border-top:solid black">
                        <td style="padding:${cellPadding}"><div style="text-align:center">
                            ${raw(ec.resource.code128Svg(boxType.pseudoId, {height: '0.4in', moduleWidth: '0.25mm', fontSize: '7pt', humanReadable: true}))}
                        </div></td>
                        <td style="padding:${cellPadding}"><div>${(boxType.description ?? "")}</div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:center">${ec.l10n.format((boxType.boxLength ?? ''), '0.###')} x ${ec.l10n.format((boxType.boxWidth ?? ''), '0.###')} x ${ec.l10n.format((boxType.boxHeight ?? ''), '0.###')} ${(boxType.dimensionAbbreviation ?? "")}</div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:center">${ec.l10n.format((boxType.boxWeight ?? ''), '0.###')} ${(boxType.weightAbbreviation ?? "")}</div></td>
                    </tr>
                </#list>
                </tbody>
            </table>
        </div></td></tr></tbody></table>
    
</section>
