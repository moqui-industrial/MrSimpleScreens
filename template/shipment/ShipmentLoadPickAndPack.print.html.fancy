<style>
@page mrss-ShipmentLoadPick { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ShipmentLoadPick { page:mrss-ShipmentLoadPick; font:10pt Helvetica,Arial,sans-serif; }
.print-ShipmentLoadPick .page-header { position:relative; min-height:0.5in; }
.print-ShipmentLoadPick .page-footer { margin-top:.2in; }
.print-ShipmentLoadPick table { border-collapse:collapse; table-layout:fixed; }
.print-ShipmentLoadPick thead { display:table-header-group; }
.print-ShipmentLoadPick tbody tr { break-inside:avoid; }
table.print-running { width:100%; }
table.print-running > tbody > tr { break-inside:auto; }
table.print-running > * > tr > td { padding:0; vertical-align:top; }
</style><style>
@page mrss-ShipmentPack { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ShipmentPack { page:mrss-ShipmentPack; font:10pt Helvetica,Arial,sans-serif; }
.print-ShipmentPack .page-header { position:relative; min-height:0.6in; }
.print-ShipmentPack .page-footer { margin-top:.2in; }
.print-ShipmentPack table { border-collapse:collapse; table-layout:fixed; }
.print-ShipmentPack thead { display:table-header-group; }
.print-ShipmentPack tbody tr { break-inside:avoid; }
</style><style>
@page mrss-ShipmentLoadPickAndPack { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ShipmentLoadPickAndPack { page:mrss-ShipmentLoadPickAndPack; font:10pt Helvetica,Arial,sans-serif; }
.print-ShipmentLoadPickAndPack .page-header { position:relative; min-height:0.5in; }
.print-ShipmentLoadPickAndPack .page-footer { margin-top:.2in; }
.print-ShipmentLoadPickAndPack table { border-collapse:collapse; table-layout:fixed; }
.print-ShipmentLoadPickAndPack thead { display:table-header-group; }
.print-ShipmentLoadPickAndPack tbody tr { break-inside:avoid; }
</style>
<#-- Ported from the XSL-FO document by scripts/xslfo-to-html-print.py and by hand; the html-print mode writes the page.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
