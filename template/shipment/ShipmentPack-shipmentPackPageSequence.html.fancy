<#-- Shared print fragment, extracted from ShipmentPack.print.html.fancy. -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#assign cellPadding = "1pt">
<#assign dateFormat = (dateFormat ?? "dd MMM yyyy")>
<#assign dateTimeFormat = (dateTimeFormat ?? "yyyy-MM-dd HH:mm")>

    <#assign shipment = (shipmentInfo.shipment ?? '')>
    <#assign shipmentId = (shipment?.shipmentId ?? '')>
    <#assign fromPartyDetail = (shipmentInfo.fromPartyDetail ?? '')>
    <#assign fromContactInfo = (shipmentInfo.fromContactInfo ?? '')>
    <#assign toPartyDetail = (shipmentInfo.toPartyDetail ?? '')>
    <#assign toContactInfo = (shipmentInfo.toContactInfo ?? '')>
    <#assign packageInfoList = (shipmentInfo.packageInfoList ?? '')>
    <#assign productInfoList = (shipmentInfo.productInfoList ?? '')>

    <section class="print-ShipmentPack" style="break-after:page">
<div class="page-header">
            <#if has(logoImageLocation)>
                <div style="position:absolute;top:0in;left:0.1in;width:2in">
                    <div style="text-align:left;margin-bottom:0.2in">
                        <img src="${logoImageLocation}" style="height:0.5in;object-fit:contain">
                    </div>
                </div>
            </#if>
            <#if has(fromPartyDetail)><div style="font-size:14pt;text-align:center">${(fromPartyDetail.organizationName ?? "")}${(fromPartyDetail.firstName ?? "")} ${(fromPartyDetail.lastName ?? "")}</div></#if>
            <div style="font-size:12pt;text-align:center;margin-bottom:0.1in">Shipment Pack Sheet</div>
            <#if has(logoImageLocation)>
                <div style="position:absolute;top:0in;left:0.1in;width:2in">
                    <div style="text-align:left">
                        <img src="${logoImageLocation}" style="height:0.5in;object-fit:contain">
                    </div>
                </div>
            </#if>
            <#if has(shipment?.binLocationNumber)>
                <div style="position:absolute;top:0.1in;right:1.6in;width:0.4in">
                    <div style="text-align:center;font-size:20pt;border:solid black;padding-top:2pt;font-weight:bold;font-family:Courier, monospace">${(shipment.binLocationNumber ?? "1")}</div>
                </div>
            </#if>
            <div style="position:absolute;top:0.1in;right:0in;width:1.6in">
                <div style="text-align:right">
                    ${raw(ec.resource.code128Svg(shipmentId, {height: '0.4in', moduleWidth: '0.3mm', fontSize: '12pt', humanReadable: true}))}
                </div>
            </div>
        </div>
        

        <div class="page-body">
            <table style="margin-bottom:0.1in;width:7.5in">
                <tbody><tr>
                    <td style="padding:3pt;width:3.25in">
                        <#if has(toPartyDetail)>
                            <div style="font-weight:bold">${toPartyDetail.pseudoId}: ${(toPartyDetail?.organizationName ?? "")} ${(toPartyDetail?.firstName ?? "")} ${(toPartyDetail?.middleName ?? "")} ${(toPartyDetail?.lastName ?? "")}</div>
                        </#if>
                        <#if has(toContactInfo?.postalAddress)>
                            <#if has(toContactInfo?.postalAddress?.toName) || has(toContactInfo?.postalAddress?.attnName)>
                                <#if has(toContactInfo?.postalAddress?.toName)><div style="font-weight:bold">To: ${toContactInfo.postalAddress.toName}</div></#if>
                                <#if has(toContactInfo?.postalAddress?.attnName)><div style="font-weight:bold">Attn: ${toContactInfo.postalAddress.attnName}</div></#if>
                            <#else>
                                <div style="font-weight:bold">${(toPartyDetail?.organizationName ?? "")} ${(toPartyDetail?.firstName ?? "")} ${(toPartyDetail?.middleName ?? "")} ${(toPartyDetail?.lastName ?? "")}</div>
                            </#if>
                            <div>${(toContactInfo?.postalAddress?.address1 ?? "")}<#if has(toContactInfo?.postalAddress?.unitNumber)> #${toContactInfo.postalAddress.unitNumber}</#if></div>
                            <#if has(toContactInfo?.postalAddress?.address2)><div>${toContactInfo.postalAddress.address2}</div></#if>
                            <div>${(toContactInfo.postalAddress.city ?? "")}, ${(toContactInfo?.postalAddressStateGeo?.geoCodeAlpha2 ?? "")} ${(toContactInfo.postalAddress.postalCode ?? "")}<#if has(toContactInfo?.postalAddress?.postalCodeExt)>-${toContactInfo.postalAddress.postalCodeExt}</#if></div>
                            <#if has(toContactInfo?.postalAddress?.countryGeoId)><div>${toContactInfo.postalAddress.countryGeoId}</div></#if>
                        </#if>
                        <#if has(toContactInfo?.telecomNumber)>
                            <div><#if has(toContactInfo?.telecomNumber?.countryCode)>${toContactInfo.telecomNumber.countryCode}-</#if><#if has(toContactInfo?.telecomNumber?.areaCode)>${toContactInfo.telecomNumber.areaCode}-</#if>${(toContactInfo.telecomNumber.contactNumber ?? "")}</div>
                        </#if>
                        <#if has(toContactInfo?.emailAddress)>
                            <div>${toContactInfo.emailAddress}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:1.75in">
                        <div style="font-weight:bold">Shipment</div>
                        <div>${shipmentId}</div>
                        <#if (shipment.estimatedReadyDate != null)>
                            <div style="font-weight:bold">Est. Ready</div>
                            <div>${ec.l10n.format(shipment.estimatedReadyDate, dateTimeFormat)}</div>
                        </#if>
                        <#if (shipment.estimatedShipDate != null)>
                            <div style="font-weight:bold">Est. Ship</div>
                            <div>${ec.l10n.format(shipment.estimatedShipDate, dateTimeFormat)}</div>
                        </#if>
                        <#if (shipment.estimatedArrivalDate != null)>
                            <div style="font-weight:bold">Est. Arrival</div>
                            <div>${ec.l10n.format(shipment.estimatedArrivalDate, dateTimeFormat)}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:2.5in">
                        <#if has(carrierParty) || has(shipmentMethodEnum)>
                            <div style="font-weight:bold">Shipping Method</div>
                            <div><#if has(carrierParty) && carrierParty.partyId != "_NA_">${carrierParty.pseudoId} </#if> ${(shipmentMethodEnum?.description ?? "")}</div>
                        </#if>
                        <#if has(orderPartList)>
                            <div style="font-weight:bold">Order</div>
                            <#list orderPartList as orderPart>
                                <div>${orderPart.orderId}:${orderPart.orderPartSeqId}<#if has(orderPart?.otherPartyOrderId)> - PO ${orderPart.otherPartyOrderId}</#if></div>
                            </#list>
                        </#if>
                        <#if has(invoiceList)>
                            <div style="font-weight:bold">Invoice</div>
                            <#list invoiceList as invoice>
                                <div>${invoice.invoiceId}<#if has(invoice?.otherPartyOrderId) || has(invoice?.referenceNumber)> - PO ${(invoice.otherPartyOrderId ?? invoice.referenceNumber)}</#if></div>
                            </#list>
                        </#if>
                    </td>
                </tr></tbody>
            </table>
            <#if has(shipment?.handlingInstructions)>
                <div style="font-weight:bold;margin-top:0.1in">Shipping Instructions</div>
                <div>${shipment.handlingInstructions}</div>
            </#if>

            <#if has(productInfoList)>
                <table style="width:7.5in;border-bottom:solid black;margin-top:10pt">
                    <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:3.5in;padding:${cellPadding}"><div style="text-align:left">ID Barcode</div></td>
                        <td style="width:3in;padding:${cellPadding}"><div style="text-align:left">Product</div></td>
                        <td style="width:1in;padding:${cellPadding}"><div style="text-align:center">Quantity</div></td>
                    </tr></thead>
                    <tbody>
                    <#list productInfoList as productInfo>
                        <tr style="font-size:9pt;border-top:solid black">
                            <td style="padding:${cellPadding}"><div style="text-align:center">
                                ${raw(ec.resource.code128Svg(productInfo.pseudoId, {height: '0.4in', moduleWidth: '0.25mm', fontSize: '7pt', humanReadable: true}))}
                            </div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:left">${ec.resource.expand("ProductNameTemplate", "", productInfo)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:center">${productInfo.quantity}</div></td>
                        </tr>
                    </#list>
                    </tbody>
                </table>
            </#if>

            <#list packageInfoList as packageInfo><#if has(packageInfo?.contentInfoList)>
                <#assign routeSegments = (packageInfo.shipmentPackage.routeSegments ?? '')>
                <table style="width:7.5in;border-bottom:solid black;margin-top:0.2in">
                    <thead style="font-size:10pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:3.9in;padding:2pt"><div style="text-align:left">Package ${packageInfo_index + 1} of ${packageInfoList.length}<#if has(routeSegments) && has(routeSegments[0].trackingCode)> (${routeSegments[0].trackingCode})</#if></div></td>
                        <td style="width:1.2in;padding:2pt"><div style="text-align:center">Qty Ordered</div></td>
                        <td style="width:1.2in;padding:2pt"><div style="text-align:center">Qty in Package</div></td>
                        <td style="width:1.2in;padding:2pt"><div style="text-align:center">Total Shipped</div></td>
                    </tr></thead>
                    <tbody>
                        <#list packageInfo.contentInfoList as contentInfo>
                            <tr style="font-size:10pt">
                                <td style="padding:2pt"><div style="text-align:left">${ec.resource.expand("ProductNameTemplate", "", contentInfo.productInfo)}</div>
                                    <#if has(contentInfo?.otherPartyProductId)><div>Your Product: ${contentInfo.otherPartyProductId}</div></#if></td>
                                <td style="padding:2pt"><div style="text-align:center;font-weight:bold">${(contentInfo.quantityOrdered ?? "")}</div></td>
                                <td style="padding:2pt"><div style="text-align:center;font-weight:bold">${contentInfo.packageContent.quantity}</div></td>
                                <td style="padding:2pt"><div style="text-align:center;font-weight:bold">${(contentInfo.quantityShipped ?? "")}</div></td>
                            </tr>
                        </#list>
                    </tbody>
                </table>
            </#if></#list>
        </div>
    

<div class="page-footer" style="font-size:8pt">
            <div style="border-top:thin solid black">
                <div style="text-align:center">
                    <#if has(fromContactInfo?.postalAddress)>
                        ${(fromContactInfo?.postalAddress?.address1 ?? "")}<#if has(fromContactInfo?.postalAddress?.unitNumber)> #${fromContactInfo.postalAddress.unitNumber}</#if><#if has(fromContactInfo?.postalAddress?.address2)>, ${fromContactInfo.postalAddress.address2}</#if>, ${(fromContactInfo.postalAddress.city ?? "")}, ${(fromContactInfo?.postalAddressStateGeo?.geoCodeAlpha2 ?? "")} ${(fromContactInfo.postalAddress.postalCode ?? "")}<#if has(fromContactInfo?.postalAddress?.postalCodeExt)>-${fromContactInfo.postalAddress.postalCodeExt}</#if><#if has(fromContactInfo?.postalAddress?.countryGeoId)>, ${fromContactInfo.postalAddress.countryGeoId}</#if>
                    </#if>
                    <#if has(fromContactInfo?.telecomNumber)>
                        -- <#if has(fromContactInfo?.telecomNumber?.countryCode)>${fromContactInfo.telecomNumber.countryCode}-</#if><#if has(fromContactInfo?.telecomNumber?.areaCode)>${fromContactInfo.telecomNumber.areaCode}-</#if>${(fromContactInfo.telecomNumber.contactNumber ?? "")}
                    </#if>
                    <#if has(fromContactInfo?.emailAddress)> -- ${fromContactInfo.emailAddress}</#if>
                </div>
                <div style="text-align:center">Shipment #${shipmentId} -- <#if (shipment.estimatedShipDate != null)>${ec.l10n.format(shipment.estimatedShipDate, dateFormat)} -- </#if>Printed ${ec.l10n.format(ec.user.nowTimestamp, dateTimeFormat)}</div>
            </div>
        </div>
</section>
