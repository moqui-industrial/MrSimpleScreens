<#-- Shared print fragment, extracted from ShipmentLoadPick.print.html.fancy. -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#assign showByProductOtherLocations = false>
<#assign cellPadding = "1pt">
<#assign dateFormat = (dateFormat ?? "dd MMM yyyy")>
<#assign dateTimeFormat = (dateTimeFormat ?? "yyyy-MM-dd HH:mm")>

    <section class="print-ShipmentLoadPick" style="break-after:page">
<div class="page-header">
            <#if has(fromPartyDetail)><div style="font-size:14pt;text-align:center">${(fromPartyDetail.organizationName ?? "")}${(fromPartyDetail.firstName ?? "")} ${(fromPartyDetail.lastName ?? "")}</div></#if>
            <div style="font-size:12pt;text-align:center;margin-bottom:0.1in">Shipping Picklist</div>
            <div style="position:absolute;top:0in;right:0.5in;width:3in">
                <div style="text-align:right">
                    ${raw(ec.resource.code128Svg(workEffortId, {height: '0.4in', moduleWidth: '0.3mm', fontSize: '12pt', humanReadable: true}))}
                </div>
            </div>
        </div>
        

        <div class="page-body">
            <table style="margin-bottom:0.1in;width:7.5in">
                <tbody><tr>
                    <td style="padding:3pt;width:3in">
                        <div style="font-weight:bold">Picklist</div>
                        <div>${workEffortId}: ${(workEffort.workEffortName ?? "")}</div>
                        <#if has(warehouseFacility)>
                            <div style="font-weight:bold">Warehouse</div>
                            <div>${ec.resource.expand("FacilityNameTemplate", "", warehouseFacility)}</div>
                        </#if>
                        <#if has(dockFacility)>
                            <div style="font-weight:bold">Dock</div>
                            <div>${ec.resource.expand("FacilityNameTemplate", "", dockFacility)}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:1.5in">
                        <#if (workEffort.estimatedStartDate != null)>
                            <div style="font-weight:bold">Est. Start</div>
                            <div>${ec.l10n.format(workEffort.estimatedStartDate, dateTimeFormat)}</div>
                        </#if>
                        <#if (workEffort.estimatedWorkDuration != null)>
                            <div style="font-weight:bold">Est. Hours</div>
                            <div>${workEffort.estimatedWorkDuration}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:3in">
                        <div style="font-weight:bold">Equipment</div>
                        <#if has(assignedAssetList)>
                            <#list assignedAssetList as assignedAsset>
                                <div>${ec.resource.expand("AssetNameTemplate", "", assignedAsset)}</div>
                            </#list>
                        </#if>
                    </td>
                </tr></tbody>
            </table>

            <#if has(reservedLocationInfoList)>
                ${raw(ec.resource.template("component://SimpleScreens/template/shipment/ShipmentLoadPick-locationInfoTable.html.fancy", {locationInfoList: reservedLocationInfoList, titleString: "By Loc - Res"}))}
            </#if>
            <#if has(otherLocationInfoList)>
                ${raw(ec.resource.template("component://SimpleScreens/template/shipment/ShipmentLoadPick-locationInfoTable.html.fancy", {locationInfoList: otherLocationInfoList, titleString: "By Loc - Alt"}))}
            </#if>
            <#if has(productInfoList)>
                <table style="width:7.5in;border-bottom:solid black;margin-top:10pt">
                    <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:2in;padding:${cellPadding}"><div style="text-align:left">By Product</div></td>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Ar</div></td>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Ais</div></td>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Sec</div></td>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Lev</div></td>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Pos</div></td>
                        <td style="width:0.8in;padding:${cellPadding}"><div style="text-align:center">Cont</div></td>

                        <td style="width:1.5in;padding:${cellPadding}"><div> </div></td>
                        <td style="width:0.5in;padding:${cellPadding}"><div style="text-align:center">Bin</div></td>
                        <td style="width:1in;padding:${cellPadding}"><div style="text-align:center">Qty</div></td>
                    </tr></thead>
                    <tbody>
                    <#list productInfoList as productInfo>
                        <tr style="font-size:9pt;border-top:solid black">
                            <td colspan="5" style="padding:${cellPadding}"><div style="text-align:center">
                                ${raw(ec.resource.code128Svg(productInfo.productId, {height: '0.4in', moduleWidth: '0.25mm', fontSize: '7pt', humanReadable: true}))}
                            </div></td>
                            <td colspan="4" style="padding:${cellPadding}"><div style="text-align:left">${ec.resource.expand("ProductNameTemplate", "", productInfo)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.format((productInfo.quantity ?? ''), "#,##0.###")}</div></td>
                        </tr>
                        <#if has(productInfo?.reservedLocationInfoList)><#list productInfo.reservedLocationInfoList as locationInfo>
                            <tr style="font-size:9pt">
                                <td style="padding:${cellPadding}"><div style="text-align:left"><#if !has(locationInfo?.locationSeqId)>No Location<#else>${(locationInfo.description ?? locationInfo.locationSeqId)}</#if></div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.areaId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.aisleId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.sectionId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.levelId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.positionId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo?.container?.serialNumber ?? locationInfo?.container?.containerId ?? " ")}</div></td>

                                <td style="padding:${cellPadding}"><div> </div></td>
                                <td style="padding:${cellPadding}"><div> </div></td>
                                <td style="padding:${cellPadding}">
                                    <div style="text-align:right;font-weight:bold">${ec.l10n.format((locationInfo.quantity ?? ''), "#,##0.###")}</div></td>
                            </tr>
                            <#list Object.keys(locationInfo.quantityByBin) as binLocationNumber>
                                <tr style="font-size:9pt">
                                    <td colspan="8" style="padding:${cellPadding}"><div> </div></td>
                                    <td style="padding:${cellPadding}"><div style="text-align:center">${(binLocationNumber ?? " ")}</div></td>
                                    <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${ec.l10n.format(locationInfo.quantityByBin[binLocationNumber ?? ""], "#,##0.###")}</div></td>
                                </tr>
                            </#list>
                        </#list></#if>
                        <#if showByProductOtherLocations && has(productInfo?.otherLocationInfoList)><#list productInfo.otherLocationInfoList as locationInfo>
                            <tr style="font-size:9pt;border-top:thin solid black">
                                <td style="padding:${cellPadding}"><div style="text-align:left"><#if !has(locationInfo?.locationSeqId)>No Location<#else>${(locationInfo.description ?? " ")}</#if></div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.areaId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.aisleId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.sectionId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.levelId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo.positionId ?? "-")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${(locationInfo?.container?.serialNumber ?? locationInfo?.container?.containerId ?? " ")}</div></td>

                                <td style="padding:${cellPadding}"><div> </div></td>
                                <td style="padding:${cellPadding}"><div> </div></td>
                                <td style="padding:${cellPadding}">
                                    <div style="text-align:right;font-weight:bold">${ec.l10n.format((locationInfo.quantity ?? ''), "#,##0.###")}</div></td>
                            </tr>
                            <#list Object.keys(locationInfo.quantityByBin) as binLocationNumber>
                                <tr style="font-size:9pt">
                                    <td colspan="8" style="padding:${cellPadding}"><div> </div></td>
                                    <td style="padding:${cellPadding}"><div style="text-align:center">${(binLocationNumber ?? " ")}</div></td>
                                    <td style="padding:${cellPadding}"><div style="text-align:center;font-weight:bold">${ec.l10n.format(locationInfo.quantityByBin[binLocationNumber ?? ""], "#,##0.###")}</div></td>
                                </tr>
                            </#list>
                        </#list></#if>
                    </#list>
                    </tbody>
                </table>
            </#if>
        </div>
    

<div class="page-footer" style="font-size:8pt">
            <div style="border-top:thin solid black">
                <div style="text-align:center">Picklist #${workEffortId} -- <#if (workEffort.estimatedStartDate != null)>${ec.l10n.format(workEffort.estimatedStartDate, dateTimeFormat)} -- </#if>Printed ${ec.l10n.format(ec.user.nowTimestamp, dateTimeFormat)}</div>
            </div>
        </div>
</section>
