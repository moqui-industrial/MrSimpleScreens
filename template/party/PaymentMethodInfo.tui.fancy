<#-- the terminal twin of PaymentMethodInfo.html.fancy: one text node per line of the payment method -->
<#assign pm = methodInfo?.paymentMethod>
<#assign pa = methodInfo?.postalAddress>
<#assign tel = methodInfo?.telecomNumber>
<#assign lines = []>
<#if pm?.description><#assign lines = lines.concat([pm.description])></#if>
<#if methodInfo?.bankAccount><#assign lines = lines.concat([(methodInfo.bankAccount.bankName ?? '') + ' (' + (methodInfo.bankAccountTypeEnum?.description || methodInfo.bankAccount.typeEnumId || '') + ')', (methodInfo.bankAccount.routingNumber ?? '') + ':' + (methodInfo.bankAccount.accountNumber ?? '')])></#if>
<#if methodInfo?.creditCard><#assign lines = lines.concat([((methodInfo.creditCardTypeEnum?.description || methodInfo.creditCard.creditCardTypeEnumId || '') + ' ' + (methodInfo.maskedCardNumber ?? '') + ' ' + (methodInfo.creditCard.expireDate ?? '')).trim()])></#if>
<#if pm?.firstNameOnAccount><#assign lines = lines.concat([pm.firstNameOnAccount + ' ' + (pm.middleNameOnAccount ?? '') + (pm.lastNameOnAccount ?? '')])></#if>
<#if pm?.companyNameOnAccount><#assign lines = lines.concat([pm.companyNameOnAccount])></#if>
<#if pa?.address1><#assign lines = lines.concat([pa.address1 + (pa.unitNumber ? ' #' + pa.unitNumber : '')])></#if>
<#if pa?.address2><#assign lines = lines.concat([pa.address2])></#if>
<#if pa><#assign lines = lines.concat([((pa.city ?? '') + (methodInfo.postalAddressStateGeo?.geoCodeAlpha2 ? ', ' + methodInfo.postalAddressStateGeo.geoCodeAlpha2 : '') + ' ' + (pa.postalCode ?? '') + (pa.postalCodeExt ? '-' + pa.postalCodeExt : '')).trim()])></#if>
<#if tel><#assign lines = lines.concat(['Phone: ' + (tel.countryCode ? tel.countryCode + '-' : '') + (tel.areaCode ? tel.areaCode + '-' : '') + (tel.contactNumber ?? '')])></#if>
<#if methodInfo?.emailAddress><#assign lines = lines.concat([methodInfo.emailAddress])></#if>
${JSON.stringify(lines.map((line, i) => ({t: 'text', id: 'MethodLine' + i, text: line})))}
