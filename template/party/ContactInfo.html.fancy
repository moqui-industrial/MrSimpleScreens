<address>
<#if contactInfo?.postalAddress?.toName><strong>${ec.l10n.localize('To')}: ${contactInfo.postalAddress.toName}</strong><br></#if>
<#if contactInfo?.postalAddress?.attnName><strong>${ec.l10n.localize('Attn')}: ${contactInfo.postalAddress.attnName}</strong><br></#if>
<#if contactInfo?.postalAddress?.address1>${contactInfo.postalAddress.address1}<#if contactInfo.postalAddress.unitNumber> #${contactInfo.postalAddress.unitNumber}</#if><br></#if>
<#if contactInfo?.postalAddress?.address2>${contactInfo.postalAddress.address2}<br></#if>
<#if contactInfo?.postalAddress>${contactInfo.postalAddress.city ?? ''}<#if contactInfo.postalAddressStateGeo?.geoCodeAlpha2>, ${contactInfo.postalAddressStateGeo.geoCodeAlpha2} <#elseif contactInfo.postalAddressStateGeo?.geoName> ${contactInfo.postalAddressStateGeo.geoName} </#if>${contactInfo.postalAddress.postalCode ?? ''}<#if contactInfo.postalAddress.postalCodeExt>-${contactInfo.postalAddress.postalCodeExt}</#if><#if contactInfo.postalAddressCountryGeo?.geoCodeAlpha3> ${contactInfo.postalAddressCountryGeo.geoCodeAlpha3}</#if><br></#if>
<#if contactInfo?.telecomNumber><abbr title="${ec.l10n.localize('Phone')}">T:</abbr> <#if contactInfo.telecomNumber.countryCode>${contactInfo.telecomNumber.countryCode}-</#if><#if contactInfo.telecomNumber.areaCode>${contactInfo.telecomNumber.areaCode}-</#if>${contactInfo.telecomNumber.contactNumber ?? ''}<#if contactInfo.telecomPartyContactMech?.extension> x${contactInfo.telecomPartyContactMech.extension}</#if><br></#if>
<#if contactInfo?.emailAddress><a href="mailto:${contactInfo.emailAddress}">${contactInfo.emailAddress}</a></#if>
<#if contactInfo?.webAddress><a href="${contactInfo.webAddress}" target="_blank">${contactInfo.webAddress}</a></#if>
</address>
