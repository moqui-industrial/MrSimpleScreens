<address>
<#if methodInfo.paymentMethod?.description><strong>${methodInfo.paymentMethod.description}</strong><br></#if>

<#if methodInfo.bankAccount>
${methodInfo.bankAccount.bankName ?? ''} (${methodInfo.bankAccountTypeEnum?.description || methodInfo.bankAccount.typeEnumId || ''})<br>
${methodInfo.bankAccount.routingNumber ?? ''}:${methodInfo.bankAccount.accountNumber ?? ''}<br>
</#if>
<#if methodInfo.creditCard>${methodInfo.creditCardTypeEnum?.description || methodInfo.creditCard.creditCardTypeEnumId || ''} ${methodInfo.maskedCardNumber ?? ''} ${methodInfo.creditCard.expireDate ?? ''}<br></#if>

<#if methodInfo.paymentMethod?.firstNameOnAccount><strong>${methodInfo.paymentMethod.firstNameOnAccount} ${methodInfo.paymentMethod.middleNameOnAccount ?? ''}${methodInfo.paymentMethod.lastNameOnAccount ?? ''}</strong><br></#if>
<#if methodInfo.paymentMethod?.companyNameOnAccount><strong>${methodInfo.paymentMethod.companyNameOnAccount}</strong><br></#if>

<#if methodInfo.postalAddress?.address1>${methodInfo.postalAddress.address1}<#if methodInfo.postalAddress.unitNumber> #${methodInfo.postalAddress.unitNumber}</#if><br></#if>
<#if methodInfo.postalAddress?.address2>${methodInfo.postalAddress.address2}<br></#if>
<#if methodInfo.postalAddress>${methodInfo.postalAddress.city ?? ''}<#if methodInfo.postalAddressStateGeo?.geoCodeAlpha2>, ${methodInfo.postalAddressStateGeo.geoCodeAlpha2}</#if> ${methodInfo.postalAddress.postalCode ?? ''}<#if methodInfo.postalAddress.postalCodeExt>-${methodInfo.postalAddress.postalCodeExt}</#if><br></#if>
<#if methodInfo.telecomNumber><abbr title="${ec.l10n.localize('Phone')}">P:</abbr> <#if methodInfo.telecomNumber.countryCode>${methodInfo.telecomNumber.countryCode}-</#if><#if methodInfo.telecomNumber.areaCode>${methodInfo.telecomNumber.areaCode}-</#if>${methodInfo.telecomNumber.contactNumber ?? ''}<br></#if>
<#if methodInfo.emailAddress><a href="mailto:${methodInfo.emailAddress}">${methodInfo.emailAddress}</a></#if>
</address>