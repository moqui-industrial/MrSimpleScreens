<style>
@page mrss-Order { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-Order { page:mrss-Order; font:10pt Helvetica,Arial,sans-serif; }
.print-Order .page-header { position:relative; min-height:1.2in; }
.print-Order .page-footer { margin-top:.2in; }
.print-Order table { border-collapse:collapse; table-layout:fixed; }
.print-Order thead { display:table-header-group; }
.print-Order tbody tr { break-inside:avoid; }
</style>
<section class="print-Order">
<#-- Ported from the XSL-FO document by scripts/xslfo-to-html-print.py and by hand; the html-print mode writes the page.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#--
This software is in the public domain under CC0 1.0 Universal plus a Grant of Patent License.

To the extent possible under law, the author(s) have dedicated all
copyright and related and neighboring rights to this software to the
public domain worldwide. This software is distributed without any
warranty.

You should have received a copy of the CC0 Public Domain Dedication
along with this software (see the LICENSE.md file). If not, see
<http://creativecommons.org/publicdomain/zero/1.0/>.
-->

<#-- See the mantle.order.OrderInfoServices.get#OrderDisplayInfo service for data preparation -->

<#assign cellPadding = "1pt">
<#assign dateFormat = "dd MMM yyyy">

<#assign firstPartInfo = orderPartInfoList[0]>
<#if has(showUpc)><#assign showUpc = (showUpc == "true")><#else><#assign showUpc = firstPartInfo.isCustomerInternalOrg></#if>


<div class="page-header">
            <div style="font-size:14pt;text-align:center;margin-bottom:0.1in"><#if firstPartInfo.isCustomerInternalOrg>Purchase<#else>Sales</#if> Order #${orderId}</div>
            <table style="margin-bottom:0.1in;width:7.5in">
                <tbody><tr>
                    <td style="padding:3pt;width:3.75in">
                        <div style="font-weight:bold">Vendor</div>
                        <div>${(firstPartInfo?.vendorDetail?.organizationName ?? "")}${(firstPartInfo?.vendorDetail?.firstName ?? "")} ${(firstPartInfo?.vendorDetail?.lastName ?? "")}</div>
                        <div style="font-weight:bold">Customer</div>
                        <div>${(firstPartInfo?.customerDetail?.organizationName ?? "")}${(firstPartInfo?.customerDetail?.firstName ?? "")} ${(firstPartInfo?.customerDetail?.lastName ?? "")}</div>
                    </td>
                    <td style="padding:3pt;width:2in">
                        <div style="font-weight:bold">Date</div>
                        <div><#if (orderHeader.placedDate != null)>${ec.l10n.format(orderHeader.placedDate, dateFormat)}<#else>Not yet placed</#if></div>
                        <div style="font-weight:bold">Total</div>
                        <div>${ec.l10n.formatCurrency(orderHeader.grandTotal, orderHeader.currencyUomId)}</div>
                    </td>
                    <td style="padding:3pt;width:1.75in">
                        <div style="text-align:right">
                            ${raw(ec.resource.code128Svg(orderId, {height: '0.4in', moduleWidth: '0.3mm', fontSize: '12pt', humanReadable: true}))}
                        </div>
                    </td>
                </tr></tbody>
            </table>
        </div>
        

        <div class="page-body">

            <#list orderPartInfoList as orderPartInfo>
                <#assign orderPart = orderPartInfo.orderPart>
                <#if orderPartInfo.isCustomerInternalOrg><#assign contactInfo = orderPartInfo.facilityContactInfo>
                    <#else><#assign contactInfo = orderPartInfo></#if>

                <table style="margin-bottom:0.1in;width:7.5in">
                    <tbody><tr>
                        <td style="padding:3pt;width:2in">
                            <div style="font-weight:bold">Order Part #</div>
                            <div>${orderPart.orderPartSeqId}</div>
                            <div style="font-weight:bold">Part Total</div>
                            <div>${ec.l10n.formatCurrency(orderPart.partTotal, orderHeader.currencyUomId)}</div>
                            <#if has(orderPart?.otherPartyOrderId)>
                                <div style="font-weight:bold"><#if orderPartInfo.isVendorInternalOrg>Customer<#else>Vendor</#if> Order #</div>
                                <div>${orderPart.otherPartyOrderId}</div>
                            </#if>
                        </td>
                        <td style="padding:3pt;width:2in">
                            <#if has(orderPartInfo?.shipmentMethodEnum)>
                                <div style="font-weight:bold">Ship By</div>
                                <div>${orderPartInfo.shipmentMethodEnum.description}</div>
                            </#if>
                            <#if (orderPart.shipAfterDate != null)>
                                <div style="font-weight:bold">Ship After</div>
                                <div>${ec.l10n.format(orderPart.shipAfterDate, dateFormat)}</div>
                            </#if>
                            <#if (orderPart.shipBeforeDate != null)>
                                <div style="font-weight:bold">Ship Before</div>
                                <div>${ec.l10n.format(orderPart.shipBeforeDate, dateFormat)}</div>
                            </#if>
                            <#if (orderPart.estimatedShipDate != null)>
                                <div style="font-weight:bold">Estimated Ship</div>
                                <div>${ec.l10n.format(orderPart.estimatedShipDate, dateFormat)}</div>
                            </#if>
                            <#if (orderPart.estimatedDeliveryDate != null)>
                                <div style="font-weight:bold">Estimated Delivery</div>
                                <div>${ec.l10n.format(orderPart.estimatedDeliveryDate, dateFormat)}</div>
                            </#if>
                            <#if (orderPart.estimatedPickUpDate != null)>
                                <div style="font-weight:bold">Estimated Pick Up</div>
                                <div>${ec.l10n.format(orderPart.estimatedPickUpDate, dateFormat)}</div>
                            </#if>
                        </td>
                        <td style="padding:3pt;font-size:10pt;width:3.5in">
                            <div style="font-weight:bold">Ship To</div>
                            <#if has(contactInfo?.postalAddress)>
                                <#if has(contactInfo?.postalAddress?.toName) || has(contactInfo?.postalAddress?.attnName)>
                                    <#if has(contactInfo?.postalAddress?.toName)><div style="font-weight:bold">To: ${contactInfo.postalAddress.toName}</div></#if>
                                    <#if has(contactInfo?.postalAddress?.attnName)><div style="font-weight:bold">Attn: ${contactInfo.postalAddress.attnName}</div></#if>
                                <#else>
                                    <div style="font-weight:bold">${(orderPartInfo.customerDetail.organizationName ?? "")} ${(orderPartInfo?.customerDetail?.firstName ?? "")} ${(orderPartInfo?.customerDetail?.middleName ?? "")} ${(orderPartInfo?.customerDetail?.lastName ?? "")}</div>
                                </#if>
                                <div>${(contactInfo?.postalAddress?.address1 ?? "")}<#if has(contactInfo?.postalAddress?.unitNumber)> #${contactInfo.postalAddress.unitNumber}</#if></div>
                                <#if has(contactInfo?.postalAddress?.address2)><div>${contactInfo.postalAddress.address2}</div></#if>
                                <div>${(contactInfo.postalAddress.city ?? "")}, ${(contactInfo?.postalAddressStateGeo?.geoCodeAlpha2 ?? "")} ${(contactInfo.postalAddress.postalCode ?? "")}<#if has(contactInfo?.postalAddress?.postalCodeExt)>-${contactInfo.postalAddress.postalCodeExt}</#if><#if has(contactInfo?.postalAddress?.countryGeoId)> ${contactInfo.postalAddress.countryGeoId}</#if></div>
                            </#if>
                            <#if has(contactInfo?.telecomNumber)>
                                <div><#if has(contactInfo?.telecomNumber?.countryCode)>${contactInfo.telecomNumber.countryCode}-</#if><#if has(contactInfo?.telecomNumber?.areaCode)>${contactInfo.telecomNumber.areaCode}-</#if>${(contactInfo.telecomNumber.contactNumber ?? "")}</div>
                            </#if>
                            <#if has(contactInfo?.emailAddress)>
                                <div>${contactInfo.emailAddress}</div>
                            </#if>
                            <#--
                            <#if has(orderPartInfo?.facility)>
                                <div>${ec.resource.expand("FacilityNameTemplate", "", orderPartInfo.facility)}</div>
                            </#if>
                            -->
                        </td>
                    </tr></tbody>
                </table>

                <table style="width:100%">
                    <thead style="font-size:9pt;border-bottom:solid black"><tr>
                        <td style="width:0.3in;padding:${cellPadding}"><div style="text-align:center">Item</div></td>
                        <#if !showUpc><td style="width:1in;padding:${cellPadding}"><div>Type</div></td></#if>
                        <td style="width:2.8in;padding:${cellPadding}"><div>Description</div></td>
                        <#if showUpc><td style="width:1in;padding:${cellPadding}"><div>UPC</div></td></#if>
                        <td style="width:0.8in;padding:${cellPadding}"><div>Required By</div></td>
                        <td style="width:0.6in;padding:${cellPadding}"><div style="text-align:center">Qty</div></td>
                        <td style="width:0.9in;padding:${cellPadding}"><div style="text-align:right">Amount</div></td>
                        <td style="width:1in;padding:${cellPadding}"><div style="text-align:right">Total</div></td>
                    </tr></thead>
                    <tbody>
                        <#list orderPartInfo.partOrderItemList as orderItem>
                            <#assign isProductItem = has(orderItem?.productId) && (!(productItemTypes != null) || productItemTypes.includes(orderItem.itemTypeEnumId))>
                            <#assign itemTypeEnum = orderItem.findRelatedOne("ItemType#moqui.basic.Enumeration", true, false)>
                            <#assign orderItemTotalOut = ec.service.sync().name("mantle.order.OrderServices.get#OrderItemTotal").parameter("orderItem", orderItem).call()>
                            <#assign itemUpc = "">
                            <#if showUpc && isProductItem>
                                <#assign productIdentification = ec.entity.find("mantle.product.ProductIdentification").condition("productId", orderItem.productId).condition("productIdTypeEnumId", "PidtUpca").useCache(true).one()>
                                <#if !has(productIdentification)><#assign productIdentification = ec.entity.find("mantle.product.ProductIdentification").condition("productId", orderItem.productId).condition("productIdTypeEnumId", "PidtUpce").useCache(true).one()></#if>
                                <#assign itemUpc = (productIdentification?.idValue ?? "")>
                            </#if>
                            <tr style="font-size:8pt;border-bottom:thin solid black;<#if !has(orderItem?.parentItemSeqId)>font-weight:bold</#if>">
                                <td style="padding:${cellPadding}"><div style="text-align:<#if !has(orderItem?.parentItemSeqId)>center<#else>right</#if>">${orderItem.orderItemSeqId}</div></td>
                                <#if !showUpc><td style="padding:${cellPadding}"><div>${(itemTypeEnum?.description ?? "")}</div></td></#if>
                                <td style="padding:${cellPadding}">
                                    <div>${(orderItem.itemDescription ?? "")}</div>
                                    <#if isProductItem>
                                        <#assign product = ec.entity.find("mantle.product.Product").condition("productId", orderItem.productId).useCache(true).one()>
                                        <div>${ec.resource.expand("ProductNameTemplate", "", product)}</div>
                                    </#if>
                                </td>
                                <#if showUpc><td style="padding:${cellPadding}"><div>${(itemUpc ?? "")}</div></td></#if>
                                <td style="padding:${cellPadding}"><div>${ec.l10n.format(orderItem.requiredByDate, dateFormat)}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:center">${(orderItem.quantity ?? "1")}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.formatCurrency((orderItem.unitAmount ?? 0), orderHeader.currencyUomId, 2)}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.formatCurrency(orderItemTotalOut.itemTotal, orderHeader.currencyUomId, 2)}</div></td>
                            </tr>
                        </#list>
                        <tr style="font-size:9pt;border-top:solid black">
                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div> </div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right">Total</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right">${ec.l10n.formatCurrency(orderPart.partTotal, orderHeader.currencyUomId)}</div></td>
                        </tr>
                    </tbody>
                </table>

                <#if has(orderPartInfo?.orderPart?.shippingInstructions)>
                    <#-- <div style="margin-top:0.2in;font-weight:bold">Shipping Instructions</div> -->
                    <div style="margin-top:0.2in;white-space:pre-line">${orderPartInfo.orderPart.shippingInstructions}</div>
                </#if>
                <#if has(orderPartInfo?.orderPart?.giftMessage)>
                    <div style="margin-top:0.2in;font-weight:bold">Gift Message</div>
                    <div style="white-space:pre-line">${orderPartInfo.orderPart.giftMessage}</div>
                </#if>
                <#if orderPartInfo.isCustomerInternalOrg>
                    <#-- signature line -->
                    <div style="width:3in;margin-top:0.5in;border-top:solid black">
                        <div>${(firstPartInfo?.customerDetail?.organizationName ?? "")}${(firstPartInfo?.customerDetail?.firstName ?? "")} ${(firstPartInfo?.customerDetail?.lastName ?? "")}</div>
                    </div>
                </#if>
            </#list>
        </div>
    
<#-- The XSL-FO region-after: a margin box of this document's page, so it prints at the foot of every page -->
<#-- TODO: show vendor's contact info (customer service or billing address, phone, email)? -->
<style>@page mrss-Order { @bottom-center { content: ${cssString("Order #" + orderId + " -- " + (orderHeader.placedDate != null ? ec.l10n.format(orderHeader.placedDate, "dd MMM yyyy") : "Not yet placed") + " -- Page ")} counter(page);
    white-space: pre-wrap; font: 8pt Helvetica, Arial, sans-serif; text-align: center; vertical-align: top; border-top: thin solid black; width: 100%; } }</style>
</section>
