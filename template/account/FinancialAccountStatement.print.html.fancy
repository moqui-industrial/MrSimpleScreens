<#-- See the mantle.account.FinancialAccountServices.get#StatementPrintInfo service for data preparation -->

<#assign tableFontSize = tableFontSize ?? "9pt">
<#assign dateFormat = dateFormat ?? "dd MMM yyyy">
<#assign accountCode = financialAccount.finAccountCode ?? financialAccount.finAccountId>
<style>
    @page { size: letter portrait; margin: .9in .5in 1.1in; }
    .account-statement { font: 10pt Helvetica, sans-serif; }
    .account-statement h1, .account-statement h2 { text-align: center; margin: 0 0 .1in; }
    .account-statement h1 { font-size: 14pt; }
    .account-statement h2 { font-size: 13pt; }
    .account-statement table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .account-statement td, .account-statement th { padding: 1pt; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
    .account-statement .summary td { padding: .05in; }
    .account-statement .transactions thead { display: table-header-group; font-size: 9pt; }
    .account-statement .transactions tr { border-bottom: thin solid black; break-inside: avoid; }
    .account-statement .money { text-align: right; font-family: Courier, monospace; }
    .account-statement footer { border-top: thin solid black; text-align: center; font-size: 8pt; margin-top: .2in; }
    @media print { .account-statement footer { position: fixed; bottom: -.7in; left: 0; right: 0; } }
</style>
<section class="account-statement">
    <h1>${organizationDetail?.organizationName ?? ""}</h1>
    <h2>${ec.l10n.localize('Account Statement')}</h2>
    <table class="summary"><colgroup><col style="width: 43%"/><col style="width: 28.5%"/><col style="width: 28.5%"/></colgroup><tbody><tr>
        <td>${ownerDetail?.organizationName ?? ""}${ownerDetail?.firstName ?? ""} ${ownerDetail?.lastName ?? ""}</td>
        <td><strong>${ec.l10n.localize('Account')}</strong><div>${accountCode}</div>
            <strong>${ec.l10n.localize('From')}</strong><div><#if fromDate != null>${ec.l10n.format(fromDate, dateFormat)}<#else>${ec.l10n.localize('N/A')}</#if></div>
            <strong>${ec.l10n.localize('Through')}</strong><div>${ec.l10n.format(thruDate ?? ec.user.nowTimestamp, dateFormat)}</div></td>
        <td><strong>${ec.l10n.localize('Beginning Balance')}</strong><div>${ec.l10n.formatCurrency(beginningBalance, financialAccount.currencyUomId)}</div>
            <strong>${ec.l10n.localize('Ending Balance')}</strong><div>${ec.l10n.formatCurrency(endingBalance, financialAccount.currencyUomId)}</div></td>
    </tr></tbody></table>
    <#if (financialAccountTransList?.length> 0)>
    <table class="transactions">
        <colgroup><col style="width: 8.6%"/><col style="width: 11.4%"/><col style="width: 14.3%"/><col style="width: 31.4%"/><col style="width: 14.3%"/><col style="width: 20%"/></colgroup>
        <thead><tr><th>${ec.l10n.localize('TX')}</th><th>${ec.l10n.localize('Date')}</th><th>${ec.l10n.localize('Reason')}</th><th>${ec.l10n.localize('Comments')}</th><th class="money">${ec.l10n.localize('Amount')}</th><th class="money">${ec.l10n.localize('Balance')}</th></tr></thead>
        <tbody>
        <#list financialAccountTransList as trans>
            <tr style="font-size: ${tableFontSize}">
                <td>${trans.finAccountTransId}</td>
                <td>${ec.l10n.format(trans.transactionDate, dateFormat)}</td>
                <td>${trans["FinancialAccountTransReason#moqui.basic.Enumeration"]?.description ?? ""}</td>
                <td>${trans.comments ?? ""}</td>
                <td class="money">${ec.l10n.formatCurrency(trans.amount, financialAccount.currencyUomId)}<#if (toDecimal(trans.amount ?? 0).compare(0)>= 0)>&#8199;</#if></td>
                <td class="money">${ec.l10n.formatCurrency(trans.postBalance, financialAccount.currencyUomId)}<#if (toDecimal(trans.postBalance ?? 0).compare(0)>= 0)>&#8199;</#if></td>
            </tr>
        </#list>
        </tbody>
    </table>
    </#if>
    <footer>${ec.l10n.localize('Account')} ${accountCode} -- <#if fromDate != null>${ec.l10n.format(fromDate, dateFormat)} ${ec.l10n.localize('to')} <#else>${ec.l10n.localize('All through')} </#if>${ec.l10n.format(thruDate ?? ec.user.nowTimestamp, dateFormat)}</footer>
</section>
