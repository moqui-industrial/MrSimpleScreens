<style>
@page mrss-ReceivableStatement { size:8.5in 11in; margin:0.5in 0.5in 0.5in 0.5in; }
.print-ReceivableStatement { page:mrss-ReceivableStatement; font:10pt Helvetica,Arial,sans-serif; }
.print-ReceivableStatement .page-header { position:relative; min-height:1.0in; }
.print-ReceivableStatement .page-footer { margin-top:.2in; }
.print-ReceivableStatement table { border-collapse:collapse; table-layout:fixed; }
.print-ReceivableStatement thead { display:table-header-group; }
.print-ReceivableStatement tbody tr { break-inside:avoid; }
</style>
<section class="print-ReceivableStatement">
<#-- Ported from the XSL-FO document by scripts/xslfo-to-html-print.py and by hand; the html-print mode writes the page.
     has(x): FreeMarker's ?has_content, an empty text, list or map is false -->
<#assign has = (v) => v != null && v !== '' && (typeof v === 'object' ? (typeof v.length === 'number' ? v.length > 0 : typeof v.toNumber === 'function' || Object.keys(v).length > 0) : true)>
<#--
This software is in the public domain under CC0 1.0 Universal plus a Grant of Patent License.

To the extent possible under law, the author(s) have dedicated all
copyright and related and neighboring rights to this software to the
public domain worldwide. This software is distributed without any
warranty.

You should have received a copy of the CC0 Public Domain Dedication
along with this software (see the LICENSE.md file). If not, see
<http://creativecommons.org/publicdomain/zero/1.0/>.
-->

<#-- See the mantle.account.InvoiceServices.get#ReceivableStatementInfo service for data preparation -->

<#assign cellPadding = "4pt">
<#assign tableFontSize = (tableFontSize ?? "10pt")>
<#assign dateTimeFormat = (dateTimeFormat ?? "dd MMM yyyy HH:mm")>
<#assign dateFormat = (dateFormat ?? "dd MMM yyyy")>

<#if has(receivableInfoList)><#list receivableInfoList as receivableInfo>
<section class="receivable-page" style="break-after:page">
    <#assign fromPartyId = receivableInfo.fromPartyId>
    <#assign fromParty = receivableInfo.fromParty>
    <#assign fromContactInfo = receivableInfo.fromContactInfo>
    <#assign logoImageLocation = (receivableInfo.logoImageLocation ?? '')>
    <#assign invoiceList = receivableInfo.invoiceList>
    <#assign unappliedPaymentList = receivableInfo.unappliedPaymentList>
    <#assign agingSummaryList = receivableInfo.agingSummaryList>

    <div class="page-header">
            <div style="font-size:16pt;text-align:center">${(fromParty?.organizationName ?? "")}${(fromParty?.firstName ?? "")} ${(fromParty?.lastName ?? "")}</div>
            <div style="font-size:12pt;text-align:center;margin-bottom:0.1in">${ec.l10n.localize('Billing Statement')}</div>
            <#if has(logoImageLocation)>
                <div style="position:absolute;top:0in;left:0.1in;width:2in">
                    <div style="text-align:left">
                        <img src="${logoImageLocation}" style="height:0.5in;object-fit:contain">
                    </div>
                </div>
            </#if>
        </div>
        

        <div class="page-body">
            <table style="margin-bottom:0.3in;width:7.5in;font-size:10pt">
                <tbody><tr>
                    <td style="padding:3pt;width:3.5in">
                        <#if has(toBillingRep)><div>Attention: ${(toBillingRep?.organizationName ?? "")} ${(toBillingRep?.firstName ?? "")} ${(toBillingRep?.lastName ?? "")}</div></#if>
                        <div style="font-weight:bold">${(toParty?.organizationName ?? "")} ${(toParty?.firstName ?? "")} ${(toParty?.lastName ?? "")}</div>
                        <#if has(toContactInfo?.postalAddress)>
                            <div>${(toContactInfo?.postalAddress?.address1 ?? "")}<#if has(toContactInfo?.postalAddress?.unitNumber)> #${toContactInfo.postalAddress.unitNumber}</#if></div>
                            <#if has(toContactInfo?.postalAddress?.address2)><div>${toContactInfo.postalAddress.address2}</div></#if>
                            <div>${(toContactInfo?.postalAddress?.city ?? "")}, ${(toContactInfo?.postalAddressStateGeo?.geoCodeAlpha2 ?? "")} ${(toContactInfo.postalAddress.postalCode ?? "")}<#if has(toContactInfo?.postalAddress?.postalCodeExt)>-${toContactInfo.postalAddress.postalCodeExt}</#if></div>
                            <#if has(toContactInfo?.postalAddress?.countryGeoId)><div>${toContactInfo.postalAddress.countryGeoId}</div></#if>
                        </#if>
                        <#if has(toContactInfo?.telecomNumber)>
                            <div><#if has(toContactInfo?.telecomNumber?.countryCode)>${toContactInfo.telecomNumber.countryCode}-</#if><#if has(toContactInfo?.telecomNumber?.areaCode)>${toContactInfo.telecomNumber.areaCode}-</#if>${(toContactInfo.telecomNumber.contactNumber ?? "")}</div>
                        </#if>
                        <#if has(toContactInfo?.emailAddress)>
                            <div>${toContactInfo.emailAddress}</div>
                        </#if>
                    </td>
                    <td style="padding:3pt;width:2.25in">
                        <div style="font-weight:bold">${ec.l10n.localize('Total Unpaid')}</div>
                        <div>${ec.l10n.formatCurrency(receivableInfo.unpaidTotal, currencyUomId)}</div>
                        <div style="font-weight:bold">${ec.l10n.localize('Payments Unapplied')}</div>
                        <div>${ec.l10n.formatCurrency(receivableInfo.unappliedTotal, currencyUomId)}</div>
                        <div style="font-weight:bold">${ec.l10n.localize('Balance Due')}</div>
                        <div style="font-weight:bold">${ec.l10n.formatCurrency(receivableInfo.balanceDue, currencyUomId)}</div>
                    </td>
                    <td style="padding:3pt;width:1.75in">
                        <div style="font-weight:bold">${ec.l10n.localize('As of Date')}</div>
                        <div>${ec.l10n.format(asOfTimestamp, dateFormat)}</div>
                        <div style="font-weight:bold">${ec.l10n.localize('Customer ID')}</div>
                        <div>${toParty.pseudoId}</div>
                    </td>
                </tr></tbody>
            </table>

            <#if has(invoiceList)>
            <table style="width:100%">
                <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Invoice #')}</div></td>
                    <td style="width:1.5in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Ref/PO')}</div></td>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Invoice Date')}</div></td>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Due Date')}</div></td>
                    <td style="width:1.5in;padding:${cellPadding}"><div style="text-align:right">${ec.l10n.localize('Total')}</div></td>
                    <td style="width:1.5in;padding:${cellPadding}"><div style="text-align:right">${ec.l10n.localize('Unpaid')}</div></td>
                </tr></thead>
                <tbody>
                    <#list invoiceList as invoice>
                        <tr style="font-size:${tableFontSize};border-bottom:thin solid black">
                            <td style="padding:${cellPadding}"><div style="text-align:left">${invoice.invoiceId}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:left">${(invoice.otherPartyOrderId ?? invoice.referenceNumber ?? " ")}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:left">${ec.l10n.format(invoice.invoiceDate, dateFormat)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:left">${ec.l10n.format(invoice.dueDate, dateFormat)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(invoice.invoiceTotal, invoice.currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(invoice.unpaidTotal, invoice.currencyUomId)}</div></td>
                        </tr>
                    </#list>
                    <tr style="font-size:${tableFontSize};border-bottom:thin solid black">
                        <td style="padding:${cellPadding}"><div style="text-align:left"> </div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:left"> </div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:left"> </div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:right;font-weight:bold">Total</div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace;font-weight:bold">${ec.l10n.formatCurrency(receivableInfo.invoiceTotal, currencyUomId)}</div></td>
                        <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace;font-weight:bold">${ec.l10n.formatCurrency(receivableInfo.unpaidTotal, currencyUomId)}</div></td>
                    </tr>
                </tbody>
            </table>
            </#if>

            <#if has(unappliedPaymentList)>
                <table style="width:100%;margin-top:0.2in">
                    <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                        <td style="width:1.5in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Payment')} #</div></td>
                        <td style="width:2.5in;padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize('Date')}</div></td>
                        <td style="width:2.0in;padding:${cellPadding}"><div style="text-align:right">${ec.l10n.localize('Amount')}</div></td>
                        <td style="width:1.5in;padding:${cellPadding}"><div style="text-align:right">${ec.l10n.localize('Unapplied')}</div></td>
                    </tr></thead>
                    <tbody>
                        <#list unappliedPaymentList as payment>
                            <tr style="font-size:${tableFontSize};border-bottom:thin solid black">
                                <td style="padding:${cellPadding}"><div style="text-align:left">${payment.paymentId}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:left">${ec.l10n.format(payment.effectiveDate, dateFormat)}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency((payment.amount ?? 0), payment.amountUomId)}</div></td>
                                <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency((payment.unappliedTotal ?? 0), payment.amountUomId)}</div></td>
                            </tr>
                        </#list>
                        <tr style="font-size:${tableFontSize};border-bottom:thin solid black">
                            <td style="padding:${cellPadding}"><div style="text-align:left"> </div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-weight:bold">Total</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace;font-weight:bold">${ec.l10n.formatCurrency(receivableInfo.paymentTotal, currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace;font-weight:bold">${ec.l10n.formatCurrency(receivableInfo.unappliedTotal, currencyUomId)}</div></td>
                        </tr>
                    </tbody>
                </table>
            </#if>

            <#if has(agingSummaryList)>
            <table style="width:100%;margin-top:0.2in">
                <thead style="font-size:9pt;font-weight:bold;border-bottom:solid black"><tr>
                    <td style="width:1.0in;padding:${cellPadding}"><div style="text-align:left"> </div></td>
                    <td style="width:1.3in;padding:${cellPadding}"><div style="text-align:right">${ec.l10n.localize('Current')}</div></td>
                    <td style="width:1.3in;padding:${cellPadding}"><div style="text-align:right">0 - ${Number(periodDays)} days</div></td>
                    <td style="width:1.3in;padding:${cellPadding}"><div style="text-align:right">${Number(periodDays)+1} - ${Number(periodDays)*2} days</div></td>
                    <td style="width:1.3in;padding:${cellPadding}"><div style="text-align:right">${Number(periodDays)*2+1} - ${Number(periodDays)*3} days</div></td>
                    <td style="width:1.3in;padding:${cellPadding}"><div style="text-align:right">&gt; ${Number(periodDays)*3} days</div></td>
                </tr></thead>
                <tbody>
                    <#list agingSummaryList as summary>
                        <tr style="font-size:9pt;border-bottom:thin solid black">
                            <td style="padding:${cellPadding}"><div style="text-align:left">${ec.l10n.localize(summary.description)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(summary.current, currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(summary.period0, currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(summary.period1, currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(summary.period2, currencyUomId)}</div></td>
                            <td style="padding:${cellPadding}"><div style="text-align:right;font-family:Courier, monospace">${ec.l10n.formatCurrency(toDecimal(summary.period3 ?? 0).add(summary.periodRemaining ?? 0), currencyUomId)}</div></td>
                        </tr>
                    </#list>
                </tbody>
            </table>
            </#if>
        </div>
    <div class="page-footer" style="font-size:8pt;border-top:thin solid black;text-align:center">
        <#if has(fromContactInfo?.postalAddress)>
            ${fromContactInfo.postalAddress.address1 ?? ''}<#if has(fromContactInfo?.postalAddress?.unitNumber)> #${fromContactInfo.postalAddress.unitNumber}</#if><#if has(fromContactInfo?.postalAddress?.address2)>, ${fromContactInfo.postalAddress.address2}</#if>, ${fromContactInfo.postalAddress.city ?? ''}, ${fromContactInfo.postalAddressStateGeo?.geoCodeAlpha2 ?? ''} ${fromContactInfo.postalAddress.postalCode ?? ''}<#if has(fromContactInfo?.postalAddress?.postalCodeExt)>-${fromContactInfo.postalAddress.postalCodeExt}</#if><#if has(fromContactInfo?.postalAddress?.countryGeoId)>, ${fromContactInfo.postalAddress.countryGeoId}</#if>
        </#if>
        <#if has(fromContactInfo?.telecomNumber)> -- <#if has(fromContactInfo?.telecomNumber?.countryCode)>${fromContactInfo.telecomNumber.countryCode}-</#if><#if has(fromContactInfo?.telecomNumber?.areaCode)>${fromContactInfo.telecomNumber.areaCode}-</#if>${fromContactInfo.telecomNumber.contactNumber ?? ''}</#if>
        <#if has(fromContactInfo?.emailAddress)> -- ${fromContactInfo.emailAddress}</#if>
        <div>Statement -- ${ec.l10n.format(asOfTimestamp, dateFormat)}</div>
    </div>
</section>
    </#list><#else>
<div class="page-body">
        <#if has(toBillingRep)><div>Attention: ${(toBillingRep?.organizationName ?? "")} ${(toBillingRep?.firstName ?? "")} ${(toBillingRep?.lastName ?? "")}</div></#if>
        <div>${(toParty?.organizationName ?? "")} ${(toParty?.firstName ?? "")} ${(toParty?.lastName ?? "")}</div>
        <#if has(toContactInfo?.emailAddress)>
            <div>${toContactInfo.emailAddress}</div>
        </#if>
        <div style="font-size:12pt;margin-top:0.5in">Account is current, no unpaid invoices or unapplied payments</div>
    </div>
</#if>

</section>
